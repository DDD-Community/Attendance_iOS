# Fastlane 기본 설정
update_fastlane
default_platform(:ios)

ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "600"

# 앱 관련 변수
APP_NAME = "DDDAttendance"
SCHEME = "DDDAttendance"
STAGE_SCHEME = "DDDAttendance-Stage"
BUNDLE_ID = "io.DDD.Attendance"
OUTPUT_DIR = "./fastlane/output"
IPA_FILENAME = "#{APP_NAME}.ipa"

# 릴리스용 변수 (누락되어 있던 부분 보완)
APP_RELEASE_NAME = APP_NAME
APP_RELEASE_SCHEME = SCHEME

APP_STAGE_NAME = STAGE_SCHEME
APP_STAGE_SCHEME = STAGE_SCHEME

platform :ios do


  # 📦 Debug 빌드 + 정리
  desc "Build Debug IPA and clean ._Symbols"
  lane :build_ipa_debug_and_strip do
    clear_derived_data
    # cleanup_output_folder
    match(type: "appstore", readonly: true)

     build_app(
      workspace: "#{APP_NAME}.xcworkspace",
      scheme: "DDDAttendance_Stage",
      output_directory: OUTPUT_DIR,
      output_name: IPA_FILENAME,
      export_method: "app-store",
      clean: true,
      silent: false, # 디버깅용 false
      verbose: true,
      export_options: {
        signingStyle: "manual",
        uploadBitcode: false,
        provisioningProfiles: {
          "#{BUNDLE_ID}" => "match AppStore #{BUNDLE_ID}"
        }
      }
    )

  end

  # 📦 Release 빌드 + 정리
  desc "Build Release IPA and clean ._Symbols"
  lane :build_ipa_release_and_strip do
    clear_derived_data
    match(type: "appstore", readonly: true)

    build_app(
      workspace: "#{APP_RELEASE_NAME}.xcworkspace",
      scheme: "#{APP_RELEASE_SCHEME}",
      output_directory: OUTPUT_DIR,
      output_name: IPA_FILENAME,
      export_method: "app-store",
      clean: true,
      silent: false,
      verbose: true,
      export_options: {
        signingStyle: "manual",
        uploadBitcode: false,
        provisioningProfiles: {
          "#{BUNDLE_ID}" => "match AppStore #{BUNDLE_ID}"
        }
      }
    )

    # clean_symbols_from_ipa(ipa_path: ipa_path)
  end

  # 🚀 TestFlight 업로드 (Debug)
  desc "Upload to TestFlight (Debug)"
  lane :QA do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )
    match(type: "appstore", readonly: true)

    ipa_path = build_app(
      workspace: "#{APP_NAME}.xcworkspace",
      scheme: "#{APP_STAGE_SCHEME}",
      output_directory: OUTPUT_DIR,
      output_name: IPA_FILENAME,
      export_method: "app-store",
      clean: true,
      silent: false,
      verbose: true,
      export_options: {
        signingStyle: "manual",
        uploadBitcode: false,
        provisioningProfiles: {
          "#{BUNDLE_ID}" => "match AppStore #{BUNDLE_ID}"
        }
      }
    )

    upload_to_testflight(
      ipa: ipa_path,
      changelog: "변경사항",
      groups: ["DDD", "ddd"],
      beta_app_description: "DDD 출석 앱입니다.",
      notify_external_testers: true,
      skip_waiting_for_build_processing: true,
      demo_account_required: false,
      uses_non_exempt_encryption: false
    )
  end

  # 🚀 App Store 배포
  desc "Submit to App Store"
  lane :release do |options|
    if options[:version]
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
        is_key_content_base64: true,
        in_house: false
      )
      match(type: "appstore", readonly: true)

      ipa_path = build_app(
        workspace: "#{APP_RELEASE_NAME}.xcworkspace",
        scheme: "#{APP_RELEASE_SCHEME}",
        output_directory: OUTPUT_DIR,
        output_name: IPA_FILENAME,
        export_method: "app-store",
        clean: true,
        silent: false,
        verbose: true,
        export_options: {
          signingStyle: "manual",
          uploadBitcode: false,
          provisioningProfiles: {
            "#{BUNDLE_ID}" => "match AppStore #{BUNDLE_ID}"
          }
        }
      )

      # clean_symbols_from_ipa(ipa_path: ipa_path)

      # 먼저 업로드만 진행
      upload_to_app_store(
        app_version: options[:version],
        username: "shuwj81@daum.net",
        team_id: "KL4Y9PB9B8",
        ipa: ipa_path,
        skip_metadata: false,
        metadata_path: "./fastlane/metadata",
        skip_screenshots: true,
        force: true,
        submit_for_review: false,
        automatic_release: false,
        precheck_include_in_app_purchases: false
      )

      UI.success("🎉 앱 업로드 완료!")
      UI.important("")
      UI.important("📱 이제 App Store Connect에서 심사를 제출해주세요:")
      UI.important("   1. https://appstoreconnect.apple.com 접속")
      UI.important("   2. DDD Attendance 앱 선택")
      UI.important("   3. 기존 제출이 있으면 '제출 취소' 클릭")
      UI.important("   4. 새 버전 #{options[:version]} → '심사를 위해 제출' 클릭")
      UI.important("")
      UI.important("🔄 또는 App Store Connect에서 기존 제출을 취소한 후")
      UI.important("   아래 명령어로 자동 제출 재시도:")
      UI.important("   bundle exec fastlane submit_for_review version:'#{options[:version]}'")
      UI.important("")
      UI.success("✅ 빌드와 업로드가 성공적으로 완료되었습니다!")
    else
      UI.user_error!("⚠️ version 옵션을 지정해주세요: fastlane submit version:'1.0.0'")
    end
  end

  # 🚀 이미 업로드된 버전을 심사에 제출
  desc "Submit already uploaded version for review"
  lane :submit_for_review do |options|
    if options[:version]
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
        is_key_content_base64: true,
        in_house: false
      )

      begin
        upload_to_app_store(
          app_version: options[:version],
          username: "shuwj81@daum.net",
          team_id: "KL4Y9PB9B8",
          skip_binary_upload: true,
          skip_metadata: false,
          metadata_path: "./fastlane/metadata",
          skip_screenshots: true,
          force: true,
          submit_for_review: true,
          automatic_release: false,
          precheck_include_in_app_purchases: false,
          reject_if_possible: true
        )
        UI.success("🎉 심사 제출 완료!")
      rescue => ex
        UI.error("❌ 제출 실패: #{ex.message}")
        UI.important("")
        UI.important("🔍 App Store Connect에서 확인해야 할 사항:")
        UI.important("   1. 현재 버전의 상태 (심사 중/대기 중인지)")
        UI.important("   2. 필수 메타데이터 완성 여부")
        UI.important("   3. 스크린샷 업로드 완료 여부")
        UI.important("   4. 이전 버전 정리 완료 여부")
        UI.important("")
        UI.important("📱 App Store Connect 링크: https://appstoreconnect.apple.com")
      end
    else
      UI.user_error!("⚠️ version 옵션을 지정해주세요: fastlane submit_for_review version:'1.0.0'")
    end
  end

  # 🔍 App Store Connect 상태 확인 (디버깅용)
  desc "Check App Store Connect status for debugging"
  lane :check_status do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    require 'spaceship'

    begin
      Spaceship::ConnectAPI.login
      app = Spaceship::ConnectAPI::App.find("io.DDD.Attendance")

      if app
        UI.important("📱 앱 정보:")
        UI.important("   이름: #{app.name}")
        UI.important("   Bundle ID: #{app.bundle_id}")
        UI.important("")

        versions = app.get_app_store_versions
        UI.important("📋 버전 상태:")
        versions.each do |version|
          UI.important("   버전 #{version.version_string}: #{version.app_store_state}")
        end
      else
        UI.error("앱을 찾을 수 없습니다.")
      end
    rescue => ex
      UI.error("상태 확인 실패: #{ex.message}")
    end
  end
end
